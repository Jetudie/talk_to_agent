# ============================================
# Typist Agent Configuration
# ============================================
# Copy this file to .env and fill in your values.

# === ASR (Speech-to-Text) Configuration ===
# Backend choice: "local" or "remote".
# If left unset, typist automatically uses "local" when no API is configured.
# ASR_BACKEND=local

# Local Whisper model: "tiny", "base", "small" (default: "tiny")
# Will be automatically downloaded from Hugging Face if not present locally.
WHISPER_MODEL=tiny

# Optional custom path to a local GGML Whisper model file
# LOCAL_WHISPER_MODEL_PATH=./models/ggml-tiny.bin

# URL of remote ASR API endpoint (used when ASR_BACKEND=remote or API is set)
ASR_API_URL=http://localhost:8080/v1/audio/transcriptions

# API key for the remote ASR service (leave empty for local Whisper)
ASR_API_KEY=

# Remote ASR model name (e.g., whisper-1, large-v3)
ASR_MODEL=whisper-1

# Language hint for ASR: "en", "zh", or "auto" for auto-detect
# Supports English and Mandarin (中文)
ASR_LANGUAGE=auto

# === LLM (Language Model) API ===
# API key for the LLM service (optional: leave empty for direct offline dictation mode)
LLM_API_KEY=

# Base URL for OpenAI-compatible API
LLM_BASE_URL=https://api.openai.com/v1

# Model name (e.g., gpt-4o, gpt-4o-mini, or any OpenAI-compatible model)
LLM_MODEL=gpt-4o-mini

# === AUDIO SETTINGS ===
# RMS energy threshold to detect speech (lower = more sensitive)
SILENCE_THRESHOLD=0.02

# Seconds of silence after speech to stop recording
SILENCE_DURATION=1.5

# Maximum recording length in seconds per utterance
MAX_RECORD_SECONDS=30

# === OUTPUT SETTINGS ===
# Default output format: "plain" or "markdown"
OUTPUT_FORMAT=markdown

# Characters per second for type-out mode (0 = instant paste)
TYPING_SPEED=0

# Directory to save exported documents
SAVE_DIRECTORY=./output
